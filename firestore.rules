rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      match /wallet_transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if false; // Only server-side should create txs
      }
    }

    // Deal Rules
    match /deals/{contractId} {
      function isParticipant() {
        let data = resource.data;
        return isSignedIn() && (
          request.auth.uid == data.buyerId || 
          request.auth.uid == data.sellerId || 
          request.auth.uid == data.creatorId || 
          request.auth.uid == data.arbitratorId
        );
      }

      allow read: if isParticipant();
      allow create: if isSignedIn();
      allow update: if isParticipant();

      match /signatures/{signatureId} {
        allow read: if isParticipant();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      }

      match /disputes/{caseId} {
        allow read: if isParticipant();
        allow create: if isParticipant();
        
        match /messages/{messageId} {
          allow read: if isParticipant();
          allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        }
      }
    }
  }
}
