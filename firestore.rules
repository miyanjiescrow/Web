rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid == request.auth.uid &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100);
    }

    function isValidDeal(data) {
      return data.keys().hasAll(['title', 'amount', 'status']) &&
             data.title is string && data.title.size() <= 200 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending_signatures', 'active', 'completed', 'disputed'];
    }

    function isValidAd(data) {
      return data.keys().hasAll(['title', 'price', 'category', 'sellerId']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.sellerId == request.auth.uid;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['uid', 'contactUid', 'status']) &&
             data.uid == request.auth.uid &&
             data.contactUid is string &&
             data.status in ['active', 'blocked'];
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'reportedId', 'reason', 'status']) &&
             data.reporterId == request.auth.uid &&
             data.reportedId is string &&
             data.reason is string &&
             data.status == 'pending';
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidUser(incoming());
    }

    match /deals/{dealId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && isValidDeal(incoming()) && (incoming().buyerId == request.auth.uid || incoming().sellerId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid) && isValidDeal(incoming());
    }

    match /ads/{adId} {
      allow read: if true; // Publicly viewable
      allow create: if isSignedIn() && isValidAd(incoming());
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid && isValidAd(incoming());
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidContact(incoming());
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && isValidContact(incoming());
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidReport(incoming());
      allow read: if false; // Only admins can read reports
    }
  }
}
