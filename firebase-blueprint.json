{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "trustScore": { "type": "number" },
        "profileStatus": { "type": "string" },
        "telegramId": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid"]
    },
    "deal": {
      "title": "Deal",
      "description": "Escrow transaction record",
      "type": "object",
      "properties": {
        "contractId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_signatures", "active", "completed", "disputed"] },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "otherParty": { "type": "string" },
        "role": { "type": "string", "enum": ["buyer", "seller"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["title", "amount", "status"]
    },
    "ad": {
      "title": "Ad",
      "description": "Marketplace advertisement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["title", "price", "category", "sellerId"]
    },
    "contact": {
      "title": "Contact",
      "description": "User's contact relationship",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "contactUid": { "type": "string" },
        "nickname": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["uid", "contactUid", "status"]
    },
    "report": {
      "title": "Report",
      "description": "User reporting behavior",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "reportedId": { "type": "string" },
        "reason": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "object", "format": "timestamp" },
        "status": { "type": "string", "enum": ["pending", "resolved"] }
      },
      "required": ["reporterId", "reportedId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/deals/{dealId}": {
      "schema": "deal",
      "description": "Escrow transactions"
    },
    "/ads/{adId}": {
      "schema": "ad",
      "description": "Marketplace ads"
    },
    "/contacts/{contactId}": {
      "schema": "contact",
      "description": "User contacts and blocked list"
    },
    "/reports/{reportId}": {
      "schema": "report",
      "description": "User reports"
    }
  }
}
