{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with trust score and identity status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "trustScore": { "type": "number" },
        "profileStatus": { "enum": ["pending", "verified", "suspended"] },
        "telegramId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "phone", "nationalId"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Core deal/contract details",
      "type": "object",
      "properties": {
        "contractId": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "terms": { "type": "string", "maxLength": 2000 },
        "creatorId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "arbitratorId": { "type": "string" },
        "status": { "enum": ["draft", "pending_signatures", "active", "completed", "disputed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["contractId", "title", "amount", "buyerId", "sellerId", "status"]
    },
    "Signature": {
      "title": "Signature",
      "description": "Legal signing evidence for a deal",
      "type": "object",
      "properties": {
        "contractId": { "type": "string" },
        "userId": { "type": "string" },
        "nationalId": { "type": "string" },
        "name": { "type": "string" },
        "otpVerified": { "type": "boolean" },
        "ip": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["contractId", "userId", "nationalId", "timestamp"]
    },
    "Dispute": {
      "title": "Dispute",
      "description": "Arbitration record for a case",
      "type": "object",
      "properties": {
        "caseId": { "type": "string" },
        "contractId": { "type": "string" },
        "status": { "enum": ["open", "reviewing", "resolved"] },
        "arbitratorId": { "type": "string" },
        "finalVerdict": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caseId", "contractId", "status"]
    },
    "DisputeMessage": {
      "title": "DisputeMessage",
      "description": "Messages within a dispute room",
      "type": "object",
      "properties": {
        "disputeId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["disputeId", "senderId", "text", "timestamp"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "User wallet balance changes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "enum": ["deposit", "withdrawal", "escrow_hold", "escrow_release"] },
        "dealId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/deals/{contractId}": {
      "schema": "Deal",
      "description": "Main deals"
    },
    "/deals/{contractId}/signatures/{signatureId}": {
      "schema": "Signature",
      "description": "Signatures for a deal"
    },
    "/deals/{contractId}/disputes/{caseId}": {
      "schema": "Dispute",
      "description": "Dispute records for a deal"
    },
    "/deals/{contractId}/disputes/{caseId}/messages/{messageId}": {
      "schema": "DisputeMessage",
      "description": "Messages for a dispute"
    },
    "/users/{userId}/wallet_transactions/{txId}": {
      "schema": "WalletTransaction",
      "description": "User wallet history"
    }
  }
}
