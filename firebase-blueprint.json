{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and financial state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone_number": { "type": "string", "maxLength": 20 },
        "full_name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["user", "admin", "owner"] },
        "kyc_status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "wallet_balance": { "type": "number" },
        "escrow_locked_balance": { "type": "number" },
        "is_blocked": { "type": "boolean" },
        "blocked_reason": { "type": "string", "maxLength": 300 },
        "max_deal_amount": { "type": "number" },
        "daily_withdraw_limit": { "type": "number" },
        "max_active_deals": { "type": "number" },
        "is_withdraw_locked": { "type": "boolean" },
        "is_deal_locked": { "type": "boolean" },
        "admin_note": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["id", "phone_number", "full_name", "kyc_status", "wallet_balance", "escrow_locked_balance"]
    },
    "deal": {
      "title": "Deal",
      "description": "Escrow contract between buyer and seller",
      "type": "object",
      "properties": {
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "buyer_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "seller_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["draft", "awaiting_payment", "active", "work_submitted", "completed", "cancelled", "disputed"] },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "deadline": { "type": "string", "maxLength": 20 },
        "revisions": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "object", "format": "timestamp" },
        "updatedAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["contract_id", "title", "amount", "buyer_id", "seller_id", "status", "createdAt", "updatedAt"]
    },
    "message": {
      "title": "Contract Message",
      "description": "Chat message within a specific contract",
      "type": "object",
      "properties": {
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "message_text": { "type": "string", "maxLength": 1000 },
        "message_type": { "type": "string", "enum": ["text", "image", "voice", "file"] },
        "attachment_url": { "type": "string", "maxLength": 2048 },
        "created_at": { "type": "object", "format": "timestamp" }
      },
      "required": ["contract_id", "sender_id", "message_text", "message_type", "created_at"]
    },
    "notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "is_read": { "type": "boolean" },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["user_id", "is_read"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Immutable escrow financial ledger record",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["escrow_lock", "escrow_release", "deposit", "withdraw"] },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["user_id", "contract_id", "amount", "type", "status", "createdAt"]
    },
    "channel": {
      "title": "Messenger Channel",
      "description": "Broadcast channel inside Mianji Telegram-style messenger",
      "type": "object",
      "properties": {
        "channel_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 64 },
        "handle": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "owner_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "owner_name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 40 },
        "is_verified": { "type": "boolean" },
        "subscribers_count": { "type": "number" },
        "createdAt": { "type": "object", "format": "timestamp" },
        "updatedAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["channel_id", "title", "owner_id", "is_verified", "subscribers_count", "createdAt", "updatedAt"]
    },
    "channel_post": {
      "title": "Channel Broadcast Post",
      "description": "Broadcast message published in a messenger channel",
      "type": "object",
      "properties": {
        "channel_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 64 },
        "author_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "author_name": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 2000 },
        "message_type": { "type": "string", "enum": ["text", "image", "voice", "file"] },
        "attachment_url": { "type": "string", "maxLength": 2048 },
        "views": { "type": "number" },
        "silent": { "type": "boolean" },
        "created_at": { "type": "object", "format": "timestamp" }
      },
      "required": ["channel_id", "author_id", "text", "message_type", "views", "created_at"]
    },
    "direct_chat": {
      "title": "Direct Chat Thread",
      "description": "Canonical 1-on-1 or support direct conversation metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "is_support": { "type": "boolean" },
        "last_msg": { "type": "string", "maxLength": 500 },
        "time": { "type": "string" }
      },
      "required": ["id", "participants", "last_msg", "time"]
    },
    "direct_message": {
      "title": "Direct Message",
      "description": "Message inside a canonical direct chat room",
      "type": "object",
      "properties": {
        "chat_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "message_text": { "type": "string", "maxLength": 2000 },
        "message_type": { "type": "string", "enum": ["text", "image", "voice", "file"] },
        "attachment_url": { "type": "string", "maxLength": 2048 },
        "created_at": { "type": "string" }
      },
      "required": ["chat_id", "sender_id", "message_text", "message_type", "created_at"]
    },
    "chat_pin": {
      "title": "Pinned Message",
      "description": "Pinned message reference for a direct or contract chat room",
      "type": "object",
      "properties": {
        "room_key": { "type": "string" },
        "message_id": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "pinned_by": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["room_key", "updated_at"]
    },
    "wallet_request": {
      "title": "Wallet Request Slip",
      "description": "Deposit slip or withdrawal payout request awaiting admin verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "amount": { "type": "number" },
        "ref_code": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "decided_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "type", "amount", "ref_code", "status", "created_at"]
    },
    "support_ticket": {
      "title": "Support Ticket",
      "description": "User support inquiry and admin reply thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "reply": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "subject", "message", "status", "created_at"]
    },
    "dispute_record": {
      "title": "Dispute Arbitration Record",
      "description": "Evidence timeline and final arbitrator verdict per disputed contract",
      "type": "object",
      "properties": {
        "contract_id": { "type": "string" },
        "evidence": { "type": "array" },
        "resolution": { "type": "object" },
        "updated_at": { "type": "string" }
      },
      "required": ["contract_id", "evidence"]
    },
    "media_asset": {
      "title": "Uploaded Media Asset",
      "description": "Uploaded chat or dispute media payload metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uploader_id": { "type": "string" },
        "mime_type": { "type": "string" },
        "filename": { "type": "string" },
        "data_base64": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "uploader_id", "mime_type", "data_base64", "created_at"]
    },
    "user_contact": {
      "title": "Saved Contact",
      "description": "Personal address book contact synced per user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "full_name": { "type": "string", "maxLength": 100 },
        "phone_number": { "type": "string", "maxLength": 20 },
        "target_user_id": { "type": "string" },
        "status": { "type": "string", "enum": ["verified", "pending"] },
        "trust_score": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "owner_id", "full_name", "phone_number", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "user_contact",
      "description": "User saved contacts"
    },
    "/deals/{dealId}": {
      "schema": "deal",
      "description": "Escrow transactions"
    },
    "/contract_messages/{msgId}": {
      "schema": "message",
      "description": "Contract chat messages"
    },
    "/direct_chats/{chatId}": {
      "schema": "direct_chat",
      "description": "Direct messenger chat rooms"
    },
    "/direct_messages/{msgId}": {
      "schema": "direct_message",
      "description": "Direct messenger messages"
    },
    "/chat_pins/{pinId}": {
      "schema": "chat_pin",
      "description": "Pinned chat messages"
    },
    "/notifications/{noteId}": {
      "schema": "notification",
      "description": "User notifications"
    },
    "/transactions/{txId}": {
      "schema": "transaction",
      "description": "Financial ledger entries"
    },
    "/wallet_requests/{reqId}": {
      "schema": "wallet_request",
      "description": "User deposit and withdrawal slips"
    },
    "/support_tickets/{ticketId}": {
      "schema": "support_ticket",
      "description": "Support tickets"
    },
    "/dispute_records/{contractId}": {
      "schema": "dispute_record",
      "description": "Dispute evidence and arbitration verdicts"
    },
    "/media_assets/{mediaId}": {
      "schema": "media_asset",
      "description": "Uploaded voice/image/file media payloads"
    },
    "/channels/{channelId}": {
      "schema": "channel",
      "description": "Messenger broadcast channels"
    },
    "/channel_posts/{postId}": {
      "schema": "channel_post",
      "description": "Broadcast posts within messenger channels"
    }
  }
}
