        "payout_kind": { "type": "string", "enum": ["card", "sheba"] },
        "source_card": { "type": "string", "maxLength": 32 },
        "source_bank_name": { "type": "string", "maxLength": 64 },
        "slip_image_url": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
