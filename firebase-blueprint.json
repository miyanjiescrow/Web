{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and financial state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone_number": { "type": "string", "maxLength": 20 },
        "full_name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 64 },
        "avatar_url": { "type": "string", "maxLength": 2048 },
        "saved_cards": { "type": "array" },
        "sessions_revoked_before": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin", "owner"] },
        "kyc_status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "wallet_balance": { "type": "number" },
        "escrow_locked_balance": { "type": "number" },
        "is_blocked": { "type": "boolean" },
        "blocked_reason": { "type": "string", "maxLength": 300 },
        "max_deal_amount": { "type": "number" },
        "daily_withdraw_limit": { "type": "number" },
        "max_active_deals": { "type": "number" },
        "is_withdraw_locked": { "type": "boolean" },
        "is_deal_locked": { "type": "boolean" },
        "admin_note": { "type": "string", "maxLength": 500 },
        "national_id": { "type": "string", "maxLength": 10 },
        "kyc_id_card_url": { "type": "string", "maxLength": 2048 },
        "kyc_selfie_url": { "type": "string", "maxLength": 2048 },
        "kyc_bank_card": { "type": "string", "maxLength": 24 },
        "kyc_bank_name": { "type": "string", "maxLength": 64 },
        "kyc_match_status": { "type": "string", "enum": ["matched", "mismatch", "pending_manual"] },
        "kyc_match_note": { "type": "string", "maxLength": 300 },
        "kyc_match_checked_at": { "type": "string", "maxLength": 64 },
        "kyc_submitted_at": { "type": "string", "maxLength": 64 },
        "kyc_reviewed_at": { "type": "string", "maxLength": 64 },
        "kyc_reviewed_by": { "type": "string", "maxLength": 128 },
        "kyc_reject_reason": { "type": "string", "maxLength": 300 },
        "trust_score": { "type": "number" },
        "rating_avg": { "type": "number" },
        "rating_count": { "type": "number" },
        "completed_deals_count": { "type": "number" },
        "updatedAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["id", "phone_number", "full_name", "kyc_status", "wallet_balance", "escrow_locked_balance"]
    },
    "deal": {
      "title": "Deal",
      "description": "Escrow contract between buyer and seller synchronized with Mianji Telegram Bot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invite_token": { "type": "string", "maxLength": 64 },
        "bot_link": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "deadline": { "type": "number" },
        "description": { "type": "string", "maxLength": 4000 },
        "free_edits": { "type": "number" },
        "free_edits_total": { "type": "number" },
        "free_edits_left": { "type": "number" },
        "commission_payer": { "type": "string", "enum": ["freelancer", "employer", "shared", "split_50_50"] },
        "fee_percent": { "type": "number" },
        "fee_amount": { "type": "number" },
        "employer_fee": { "type": "number" },
        "freelancer_fee": { "type": "number" },
        "employer_total_payable": { "type": "number" },
        "net_seller_amount": { "type": "number" },
        "staged_payment": { "type": "boolean" },
        "is_milestone": { "type": "boolean" },
        "milestones": { "type": "array" },
        "creator_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "created_by": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "buyer_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "seller_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "buyer_role": { "type": "string", "enum": ["employer"] },
        "seller_role": { "type": "string", "enum": ["freelancer"] },
        "buyer_fullname": { "type": "string", "maxLength": 120 },
        "buyer_phone": { "type": "string", "maxLength": 20 },
        "buyer_national_id": { "type": "string", "maxLength": 16 },
        "seller_fullname": { "type": "string", "maxLength": 120 },
        "seller_phone": { "type": "string", "maxLength": 20 },
        "seller_national_id": { "type": "string", "maxLength": 16 },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "pending_party_b",
            "pending_approval",
            "awaiting_payment",
            "pending_payment",
            "awaiting_escrow_deposit",
            "awaiting_receipt_approval",
            "active",
            "in_progress",
            "paid",
            "work_submitted",
            "delivered",
            "in_inspection",
            "revisions_requested",
            "completed",
            "cancelled",
            "in_dispute",
            "disputed"
          ]
        },
        "escrow_deposit_status": { "type": "string", "enum": ["unpaid", "paid_locked", "released", "refunded"] },
        "buyer_signed_at": { "type": "string", "maxLength": 64 },
        "seller_signed_at": { "type": "string", "maxLength": 64 },
        "buyer_otp_verified": { "type": "boolean" },
        "seller_otp_verified": { "type": "boolean" },
        "buyer_signature_hash": { "type": "string", "maxLength": 128 },
        "seller_signature_hash": { "type": "string", "maxLength": 128 },
        "revisions": { "type": "string", "maxLength": 20 },
        "inspection_hours": { "type": "string", "maxLength": 10 },
        "delivery_note": { "type": "string", "maxLength": 2000 },
        "delivery_attachment_url": { "type": "string", "maxLength": 2048 },
        "revision_note": { "type": "string", "maxLength": 2000 },
        "dispute_reason": { "type": "string", "maxLength": 2000 },
        "work_submitted_at": { "type": "string", "maxLength": 64 },
        "delivery_due_at": { "type": "string", "maxLength": 64 },
        "deadline_warning_sent": { "type": "string", "maxLength": 64 },
        "deadline_overdue_sent": { "type": "string", "maxLength": 64 },
        "auto_release_at": { "type": "string", "maxLength": 64 },
        "auto_release_warning_sent": { "type": "string", "maxLength": 64 },
        "auto_released": { "type": "boolean" },
        "resolution": { "type": "object" },
        "appeal": { "type": "object" },
        "invite_mode": { "type": "boolean" },
        "pending_phone": { "type": "string", "maxLength": 20 },
        "invite_claimed_at": { "type": "string", "maxLength": 64 },
        "history": { "type": "array" },
        "timeline": { "type": "array" },
        "created_at": { "type": "string", "maxLength": 64 },
        "updated_at": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "object", "format": "timestamp" },
        "updatedAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["contract_id", "title", "amount", "status"]
    },
    "message": {
      "title": "Contract Message",
      "description": "Chat message within a specific contract",
      "type": "object",
      "properties": {
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "message_text": { "type": "string", "maxLength": 2000 },
        "message_type": { "type": "string", "enum": ["text", "image", "voice", "file", "deal"] },
        "attachment_url": { "type": "string", "maxLength": 2048 },
        "reply_to": { "type": "object" },
        "edited_at": { "type": "string" },
        "reactions": { "type": "object" },
        "read_by": { "type": "array", "items": { "type": "string" } },
        "is_system": { "type": "boolean" },
        "deal_id": { "type": "string" },
        "deal_snapshot": { "type": "object" },
        "forwarded_from": { "type": "object" },
        "created_at": { "type": "object", "format": "timestamp" }
      },
      "required": ["contract_id", "sender_id", "message_text", "message_type", "created_at"]
    },
    "notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "kind": { "type": "string", "enum": ["deal", "message", "channel", "wallet", "support", "system"] },
        "url": { "type": "string", "maxLength": 300 },
        "is_read": { "type": "boolean" },
        "createdAt": { "type": "object", "format": "timestamp" }
      },
      "required": ["user_id", "is_read"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Immutable escrow financial ledger record",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contract_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["escrow_lock", "escrow_release", "deposit", "withdraw", "platform_fee"] },
